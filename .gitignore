# =============================
# Substrate / Polkadot SDK
# Standard .gitignore
# =============================

# Ignore build outputs
target/
*/target/

# Ignore generated wasm files
*.wasm
*.wast
*.wasm.map
*.contract
wasm-debug/
wasm-release/

# Ignore Rust build artifacts
*.rlib
*.rmeta
*.d
*.so
*.dll
*.dylib
*.o

# WASM runtime artifacts
runtime/wasm/
runtime/target/

# Ignore node keys & chains
chains/
keystore/
keys/

# Ignore RocksDB / databases (VERY LARGE)
db/
tmp/
local/
data/
*.db

# Ignore logs
*.log
logs/
log/

# Ignore lock files generated by Substrate CLI
*.lock

# Cargo / Rust
# (Cargo.lock should be INCLUDED for binaries, EXCLUDED for libraries)
# If this is a workspace template, keep Cargo.lock
# If library crate: uncomment line below
# Cargo.lock

# MacOS system files
.DS_Store
.AppleDouble
.LSOverride

# NodeJS artifacts (if UI code included)
node_modules/
npm-debug.log
yarn-error.log
dist/
build/

# JetBrains / VSCode
.idea/
.vscode/
*.swp
*.swo

# Python optional scripts
__pycache__/
*.pyc

# Generated benchmark output
*.csv
